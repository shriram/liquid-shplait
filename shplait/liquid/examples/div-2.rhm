#lang shplait/liquid

// In shplait, nz is a constructor, not a type. Here a refinement can
// say "an Int0 built with nz", so div can demand it of its second
// argument.

type Int0
| nz(n :: {v :: Int | v != 0})
| z()

// A measure is a function that refinements may call.
measure fun is_nz(x :: Int0) :: Boolean:
  match x
  | nz(n): #true
  | z(): #false

fun i(n :: Int) :: Int0:
  if (n == 0):
  | z()
  | nz(n)

fun add(n1 :: Int0, n2 :: Int0) :: Int0:
  match n1
  | z():
      match n2
      | z(): z()
      | nz(nb): nz(nb)
  | nz(na):
      match n2
      | z(): nz(na)
      | nz(nb): i(na + nb)

fun div(n1 :: Int0, {n2 :: Int0 | is_nz(n2)}) :: Int0:
  match n1
  | z(): z()
  | nz(na):
      match n2
      | z(): unreachable()
      | nz(nb): i(na / nb)

check:
  div(nz(10), nz(2))
  ~is nz(5)
check:
  div(nz(1), nz(2))
  ~is z()

// error: is_nz(z()) is violated
// div(nz(10), z())
// error: is_nz(add(nz(1), nz(1))) is violated when add(...) = z()
// div(nz(10), add(nz(1), nz(1)))
// error: is_nz(add(nz(1), nz(-1))) is violated when add(...) = z()
// div(nz(10), add(nz(1), nz(-1)))
// error: is_nz(i(2)) is violated when i(...) = z()
// div(nz(10), i(2))
