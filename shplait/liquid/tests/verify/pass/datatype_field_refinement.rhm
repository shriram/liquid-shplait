#lang shplait/liquid

// A datatype field may carry a refinement.  It is PROVED where the
// constructor is applied and ASSUMED where a `match` pattern binds
// the field, which is what lets `area` return a positive number
// without a guard.

type Shape
| circle(radius :: { r :: Int | r > 0 })
| square(side :: { s :: Int | s > 0 })

fun area(sh :: Shape) :: { a :: Int | a > 0 }:
  match sh
  | circle(r): 3 * r * r
  | square(s): s * s

fun grow({n :: Int | n > 0}) :: Shape:
  circle(n + 1)

area(circle(2))
area(square(5))
area(grow(1))
